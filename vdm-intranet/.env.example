# ============================================================
# VDM-INTRANET — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# --- Seed (uniquement pour npx prisma db seed) ---
# Mot de passe initial de tous les comptes créés par le seed.
# NE PAS utiliser '1234' ou tout autre mot de passe trivial.
# Les utilisateurs devront le changer à leur première connexion.
SEED_PASSWORD="ChangezMoi-AvantLeSeed-2024!"

# --- Base de données PostgreSQL ---
DATABASE_URL="postgresql://vdm_user:vdm_password@localhost:5434/vdm_intranet?schema=public"
POSTGRES_USER=vdm_user
POSTGRES_PASSWORD=vdm_password
POSTGRES_DB=vdm_intranet

# --- JWT ---
JWT_SECRET="remplacer-par-un-secret-de-64-caracteres-minimum-tres-securise"
JWT_EXPIRES_IN="8h"

# --- Cookie ---
COOKIE_NAME="vdm_token"
# COOKIE_DOMAIN: restreindre le domaine en production (ex: .veilleurdesmedias.com)
# COOKIE_DOMAIN=".veilleurdesmedias.com"
# COOKIE_SECURE: forcer https (défaut: true si NODE_ENV=production)
# COOKIE_SECURE=true

# --- API (NestJS) ---
API_PORT=3001
CORS_ORIGINS="http://localhost:3000"

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:3001"

# --- Présences ---
PRESENCE_LATE_TOLERANCE_MINUTES=0

# --- Environnement ---
NODE_ENV=development
