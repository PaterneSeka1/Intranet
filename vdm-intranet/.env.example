# ============================================================
# VDM-INTRANET — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# --- Base de données PostgreSQL ---
DATABASE_URL="postgresql://vdm_user:vdm_password@localhost:5434/vdm_intranet?schema=public"
POSTGRES_USER=vdm_user
POSTGRES_PASSWORD=vdm_password
POSTGRES_DB=vdm_intranet

# --- JWT ---
JWT_SECRET="remplacer-par-un-secret-de-64-caracteres-minimum-tres-securise"
JWT_EXPIRES_IN="8h"

# --- Cookie ---
COOKIE_NAME="vdm_token"
COOKIE_SECRET="remplacer-par-un-secret-cookie-different-du-jwt"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE=false

# --- API (NestJS) ---
API_PORT=3001
API_HOST=localhost
CORS_ORIGINS="http://localhost:3000"

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_NAME="Veilleur des Médias — Intranet"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Présences ---
PRESENCE_LATE_TOLERANCE_MINUTES=0

# --- Environnement ---
NODE_ENV=development
