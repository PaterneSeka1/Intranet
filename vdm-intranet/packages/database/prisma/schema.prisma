generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  PDG
  CTO_ADMIN
  DAF
  RESPONSABLE_BU
  RESPONSABLE_POLE
  EMPLOYE
  CONSULTANT
  STAGIAIRE
  PRESTATAIRE
}

enum PresenceStatus {
  PRESENT
  ABSENT
  LATE
}

enum ConnectionLogType {
  LOGIN
  LOGOUT
}

enum LogAction {
  LOGIN
  LOGOUT
  VIEW
  CREATE
  UPDATE
  DELETE
  EXPORT
  GEOLOCATION
  TAB_CREATED
  TAB_UPDATED
  TAB_DELETED
  TAB_ENABLED
  TAB_DISABLED
  TAB_REORDERED
  TAB_FOLDER_CREATED
  TAB_FOLDER_UPDATED
  TAB_FOLDER_DELETED
  TAB_FOLDER_REORDERED
  TAB_CREDENTIAL_SET
  TAB_CREDENTIAL_DELETED
  TAB_CREDENTIAL_VIEWED
  REPORT_EXPORTED
  PRESENCE_REPORT_EXPORTED
  ACTIVITY_REPORT_EXPORTED
  CONNECTION_REPORT_EXPORTED
  GENERAL_REPORT_EXPORTED
  EMPLOYEE_REPORT_EXPORTED
  ANNOUNCEMENT_CREATED
  ANNOUNCEMENT_UPDATED
  ANNOUNCEMENT_DELETED
  SCHEDULE_GROUP_CREATED
  SCHEDULE_GROUP_UPDATED
  SCHEDULE_GROUP_DELETED
  DAY_ENDED
  WORKPLACE_LOCATION_UPDATED
}

// ============================================================
// ENTITÉS PRINCIPALES
// ============================================================

model BusinessUnit {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users          User[]
  poles          Pole[]
  scheduleGroups ScheduleGroup[]
  tabs           PortalTab[]
  sharedTabs     PortalTabShare[]
  tabFolders     PortalTabFolder[]
  sharedFolders  PortalTabFolderShare[]
  announcements  Announcement[]

  @@map("business_units")
}

model Pole {
  id             String   @id @default(cuid())
  name           String
  code           String   @unique
  businessUnitId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  businessUnit   BusinessUnit    @relation(fields: [businessUnitId], references: [id])
  users          User[]
  scheduleGroups ScheduleGroup[]

  @@map("poles")
}

model ScheduleGroup {
  id                    String   @id @default(cuid())
  name                  String
  code                  String   @unique
  description           String?
  expectedArrivalTime   String
  expectedDepartureTime String?
  businessUnitId        String?
  poleId                String?
  isNightShift          Boolean  @default(false)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  pole         Pole?         @relation(fields: [poleId], references: [id])
  users        User[]

  @@map("schedule_groups")
}

model User {
  id                              String    @id @default(cuid())
  username                        String    @unique
  // Identifiant de connexion pour les employés (matricule RH). NULL pour les stagiaires, qui
  // n'ont pas de matricule et se connectent avec leur email — voir AuthService.login (matricule
  // OU email, jamais username). Distinct de `username`, conservé comme identifiant technique
  // interne (aligné historiquement sur le matricule CONGE, voir leave-match.util.ts).
  matricule                       String?   @unique
  passwordHash                    String
  firstName                       String?
  lastName                        String?
  fullName                        String?
  // Obligatoire pour tout le monde sans exception : identifiant de connexion pour les stagiaires
  // (pas de matricule) et canal de réinitialisation de mot de passe pour tous les rôles.
  email                           String    @unique
  role                            Role
  businessUnitId                  String?
  poleId                          String?
  managerId                       String?
  scheduleGroupId                 String?
  individualExpectedArrivalTime   String?
  individualExpectedDepartureTime String?
  // Motif hebdomadaire récurrent (convention Date.getUTCDay() : 0=Dimanche…6=Samedi). Un tableau
  // vide est valide : signifie que le planning de l'employé est entièrement défini par mandats
  // (ex: rotation Pôle TV/Radio, sans jour fixe).
  workingDays                     Int[]     @default([1, 2, 3, 4, 5])
  isActive                        Boolean   @default(true)
  mustChangePassword              Boolean   @default(false)
  failedLoginAttempts             Int       @default(0)
  lockoutUntil                    DateTime?
  lastLoginAt                     DateTime?
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt

  businessUnit               BusinessUnit?             @relation(fields: [businessUnitId], references: [id])
  pole                       Pole?                     @relation(fields: [poleId], references: [id])
  manager                    User?                     @relation("Hierarchy", fields: [managerId], references: [id])
  subordinates               User[]                    @relation("Hierarchy")
  scheduleGroup              ScheduleGroup?            @relation(fields: [scheduleGroupId], references: [id])
  presences                  Presence[]
  connectionLogs             ConnectionLog[]
  mandates                   DailyMandate[]            @relation("MandateSubject")
  createdMandates            DailyMandate[]            @relation("MandateCreator")
  createdTabs                PortalTab[]               @relation("TabCreator")
  createdTabFolders          PortalTabFolder[]         @relation("TabFolderCreator")
  updatedTabCredentials      PortalTabCredential[]     @relation("TabCredentialUpdater")
  createdAnnouncements       Announcement[]            @relation("AnnouncementCreator")
  activityLogs               ActivityLog[]
  passwordResetTokens        PasswordResetToken[]
  notifications              Notification[]
  workplaceLocationUpdates   WorkplaceLocation[]
  createdConversations       Conversation[]            @relation("ConversationCreator")
  conversationParticipations ConversationParticipant[]
  messages                   Message[]
  messageDeletions           MessageDeletion[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================================
// PRÉSENCE & CONNEXIONS
// ============================================================

model Presence {
  id                          String         @id @default(cuid())
  userId                      String
  date                        DateTime       @db.Date
  status                      PresenceStatus
  expectedArrivalTime         String
  officialArrivalTime         DateTime?
  delayMinutes                Int?
  expectedDepartureTime       String?
  officialDepartureTime       DateTime?
  departureDelayMinutes       Int?
  latitude                    Float?
  longitude                   Float?
  accuracy                    Float?
  address                     String?
  mapsUrl                     String?
  departureLatitude           Float?
  departureLongitude          Float?
  departureAccuracy           Float?
  departureAddress            String?
  departureMapsUrl            String?
  // Écart par rapport au lieu de travail de référence (WorkplaceLocation), calculé une seule fois
  // à la première connexion du jour (seul moment où la géolocalisation est obligatoire — voir
  // PresenceService.processFirstLogin). null tant qu'aucun lieu de travail n'est configuré :
  // ne signifie jamais "sur site", à distinguer de isOffSite=false.
  isOffSite                   Boolean?
  distanceFromWorkplaceMeters Float?
  sourceConnectionLogId       String?
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt

  user                User           @relation(fields: [userId], references: [id])
  sourceConnectionLog ConnectionLog? @relation("PresenceSourceConnectionLog", fields: [sourceConnectionLogId], references: [id], onDelete: SetNull)

  @@unique([userId, date])
  @@index([date, status])
  @@map("presences")
}

model ConnectionLog {
  id                     String            @id @default(cuid())
  userId                 String
  type                   ConnectionLogType
  date                   DateTime          @db.Date
  connectedAt            DateTime          @default(now())
  disconnectedAt         DateTime?
  latitude               Float?
  longitude              Float?
  accuracy               Float?
  address                String?
  mapsUrl                String?
  userAgent              String?
  ipAddress              String?
  isFirstConnectionOfDay Boolean           @default(false)
  createdAt              DateTime          @default(now())

  user             User       @relation(fields: [userId], references: [id])
  sourcedPresences Presence[] @relation("PresenceSourceConnectionLog")

  @@index([userId, date, type])
  // Recherches globales (rôles CTO_ADMIN/DAF) filtrant par date/type sans userId — même raison
  // que ActivityLog.occurredAt ci-dessus (reports.getConnectionRows, pilotage.getConnectionsChart).
  @@index([date, type])
  @@map("connection_logs")
}

// ============================================================
// LIEU DE TRAVAIL DE RÉFÉRENCE (géofencing présence)
// ============================================================

// Singleton applicatif : un seul lieu de travail global pour toute l'agence (voir
// PresenceService.getWorkplaceLocation/upsertWorkplaceLocation, qui met à jour l'unique ligne
// existante au lieu d'en créer une nouvelle). Sert de point de référence pour détecter une
// première connexion du jour hors site (cf. Presence.isOffSite).
model WorkplaceLocation {
  id           String   @id @default(cuid())
  label        String
  latitude     Float
  longitude    Float
  radiusMeters Int      @default(150)
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("workplace_locations")
}

// ============================================================
// MANDATS JOURNALIERS
// ============================================================

model DailyMandate {
  id                    String   @id @default(cuid())
  userId                String
  date                  DateTime @db.Date
  expectedArrivalTime   String
  expectedDepartureTime String? // Heure de départ dérogatoire pour ce jour (ex: rotation nuit/week-end)
  isNightShift          Boolean? // Override explicite du flag nuit du groupe pour ce jour (null = hérite du groupe)
  reason                String?
  createdById           String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user      User @relation("MandateSubject", fields: [userId], references: [id])
  createdBy User @relation("MandateCreator", fields: [createdById], references: [id])

  @@unique([userId, date])
  // Requêtes par date (ou plage de dates) sans userId — presence.getMandates, pilotage.getSummary/
  // getPresenceByBu, reports.computeAttendanceSummaries.
  @@index([date])
  @@map("daily_mandates")
}

// ============================================================
// ONGLETS PAR BU
// ============================================================

model PortalTab {
  id             String   @id @default(cuid())
  name           String
  url            String
  description    String?
  icon           String?
  color          String?
  businessUnitId String?
  // Dossier optionnel de regroupement. Rang manuel (drag & drop) : `order` n'est significatif
  // qu'au sein d'un même groupe (mêmes folderId) — pas d'unicité ni de suite globale exigée.
  folderId       String?
  order          Int      @default(0)
  createdById    String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  businessUnit BusinessUnit?        @relation(fields: [businessUnitId], references: [id])
  // Suppression d'un dossier = les onglets redeviennent "sans dossier" (jamais supprimés).
  folder       PortalTabFolder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdBy    User                 @relation("TabCreator", fields: [createdById], references: [id])
  // Identifiant partagé optionnel (un seul par onglet) — voir PortalTabCredential.
  credential   PortalTabCredential?
  // BU supplémentaires qui voient aussi l'onglet — voir PortalTabShare.
  shares       PortalTabShare[]

  @@unique([businessUnitId, url])
  @@map("portal_tabs")
}

// Partage d'un onglet de BU avec d'autres BU (onglet "commun" à plusieurs BU sans être global).
// La BU propriétaire (PortalTab.businessUnitId) reste seule à le gérer et fixe son dossier/rang ;
// les BU destinataires le voient en lecture (hors dossier, les dossiers étant propres à une BU).
// Partage réservé aux gestionnaires globaux (CAN_MANAGE_TABS_GLOBAL), jamais sur un onglet global.
model PortalTabShare {
  tabId          String
  businessUnitId String
  createdAt      DateTime @default(now())

  tab          PortalTab    @relation(fields: [tabId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@id([tabId, businessUnitId])
  @@index([businessUnitId])
  @@map("portal_tab_shares")
}

// Identifiant partagé (compte commun à tous les utilisateurs voyant l'onglet) rattaché à un
// PortalTab, ex. abonnement/outil externe où toute l'agence ou toute une BU se connecte avec le
// même identifiant. Optionnel : la plupart des onglets n'en ont pas. Visibilité = même portée que
// l'onglet lui-même (BU/global) ; gestion (créer/modifier/supprimer) réservée aux mêmes rôles que
// la gestion de l'onglet (cf. TabsService.assertCanManage / assertCanViewTab).
model PortalTabCredential {
  id          String   @id @default(cuid())
  tabId       String   @unique
  username    String
  // Chiffré AES-256-GCM (format "iv:authTag:ciphertext", chaque partie en base64) — jamais le mot
  // de passe en clair en base. Voir apps/api/src/common/crypto/tab-credential-crypto.util.ts.
  passwordEnc String   @db.Text
  notes       String?
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tab       PortalTab @relation(fields: [tabId], references: [id], onDelete: Cascade)
  updatedBy User      @relation("TabCredentialUpdater", fields: [updatedById], references: [id])

  @@map("portal_tab_credentials")
}

model PortalTabFolder {
  id             String   @id @default(cuid())
  name           String
  icon           String?
  color          String?
  businessUnitId String?
  // Rang manuel (drag & drop) parmi les dossiers du même périmètre (même businessUnitId).
  order          Int      @default(0)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  createdBy    User          @relation("TabFolderCreator", fields: [createdById], references: [id])
  tabs         PortalTab[]
  // BU supplémentaires qui voient aussi le dossier et ses onglets — voir PortalTabFolderShare.
  shares       PortalTabFolderShare[]

  @@map("portal_tab_folders")
}

// Partage d'un dossier de BU avec d'autres BU : même principe que PortalTabShare (BU propriétaire
// seule gestionnaire, partage réservé aux gestionnaires globaux, jamais sur un dossier global).
// Partager un dossier rend visibles aux BU destinataires tous les onglets qu'il contient.
model PortalTabFolderShare {
  folderId       String
  businessUnitId String
  createdAt      DateTime @default(now())

  folder       PortalTabFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit    @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@id([folderId, businessUnitId])
  @@index([businessUnitId])
  @@map("portal_tab_folder_shares")
}

// ============================================================
// ANNONCES
// ============================================================

model Announcement {
  id             String    @id @default(cuid())
  title          String
  body           String
  businessUnitId String?
  isPinned       Boolean   @default(false)
  isActive       Boolean   @default(true)
  publishedAt    DateTime  @default(now())
  expiresAt      DateTime?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  businessUnit  BusinessUnit?  @relation(fields: [businessUnitId], references: [id])
  createdBy     User           @relation("AnnouncementCreator", fields: [createdById], references: [id])
  notifications Notification[]

  @@map("announcements")
}

// ============================================================
// PARAMÈTRES GLOBAUX DE L'APPLICATION
// ============================================================

model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ============================================================
// JOURS FÉRIÉS
// ============================================================

model PublicHoliday {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  label       String
  isRecurring Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, label])
  @@index([date])
  @@map("public_holidays")
}

// ============================================================
// JOURNAL D'ACTIVITÉ
// ============================================================

model ActivityLog {
  id         String    @id @default(cuid())
  userId     String
  action     LogAction
  entity     String?
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  occurredAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, occurredAt])
  // Recherches globales (rôles CTO_ADMIN/DAF) filtrant par date sans userId — l'index composite
  // ci-dessus, préfixé par userId, ne les sert pas efficacement (reports.getActivityRows,
  // pilotage.getActivityChart/getActivityLog).
  @@index([occurredAt])
  @@map("activity_logs")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

enum NotificationType {
  MANDATE_ASSIGNED
  ANNOUNCEMENT_PUBLISHED
  GENERAL
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  type           NotificationType @default(GENERAL)
  title          String
  body           String
  link           String?
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())
  announcementId String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Supprimer une annonce supprime automatiquement les notifications qui y sont liées.
  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([announcementId])
  @@map("notifications")
}

// ============================================================
// MESSAGERIE INTERNE (CHAT)
// ============================================================

enum ConversationType {
  DIRECT
  GROUP
}

model Conversation {
  id          String           @id @default(cuid())
  type        ConversationType
  // Nom du groupe uniquement (DIRECT : construit côté client à partir des participants).
  name        String?
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  createdBy    User                      @relation("ConversationCreator", fields: [createdById], references: [id])
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  // Groupe uniquement : peut renommer le groupe et gérer les participants.
  isAdmin        Boolean   @default(false)
  joinedAt       DateTime  @default(now())
  // Lu/non-lu dérivé de cette date plutôt qu'une table de statuts par message : un message est
  // non lu pour ce participant si createdAt > lastReadAt (ou lastReadAt null).
  lastReadAt     DateTime?
  // Épinglage et masquage : préférences propres à ce participant, jamais visibles des autres.
  isPinned       Boolean   @default(false)
  pinnedAt       DateTime?
  // "Suppression" d'une conversation = masquage de sa liste pour ce participant seulement (les
  // autres et l'historique ne sont pas affectés) ; elle réapparaît si un nouveau message arrive
  // après cette date, cf. ChatService.listConversations.
  hiddenAt       DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

enum MessageType {
  TEXT
  FILE
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String
  type           MessageType @default(TEXT)
  body           String?
  isEdited       Boolean     @default(false)
  isDeleted      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation(fields: [senderId], references: [id])
  attachments  MessageAttachment[]
  deletions    MessageDeletion[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

// "Suppression pour moi" : masquage d'un message propre à un participant, indépendant des autres —
// plusieurs participants d'un groupe peuvent chacun le masquer sans s'affecter mutuellement.
// Distinct de Message.isDeleted, qui est la suppression globale ("pour tout le monde").
model MessageDeletion {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  deletedAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_deletions")
}

model MessageAttachment {
  id         String   @id @default(cuid())
  messageId  String
  fileName   String
  mimeType   String
  size       Int
  // Chemin relatif sur le disque du serveur API (sous CHAT_UPLOADS_DIR) — jamais servi en fichier
  // statique, uniquement via un endpoint authentifié qui vérifie l'appartenance à la conversation.
  storageKey String
  createdAt  DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}
