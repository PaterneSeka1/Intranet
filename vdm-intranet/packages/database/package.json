{
  "name": "@vdm/database",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "ts-node --project tsconfig.json prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && ts-node --project tsconfig.json prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0"
  },
  "devDependencies": {
    "prisma": "^5.17.0",
    "typescript": "^5.5.4",
    "ts-node": "^10.9.2",
    "@types/node": "^22.0.0",
    "bcrypt": "^5.1.1",
    "@types/bcrypt": "^5.0.2"
  }
}
