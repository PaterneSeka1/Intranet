<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <!-- ── RESTRICTIONS ──────────────────────────────────────────────────
       Le lancement se fait directement en Chrome, mode kiosque (voir
       kiosk-vdm.sh) : pas besoin d'installer de PWA au préalable, d'où
       l'absence de WebAppInstallForceList/WebAppSettings ici (mêmes clés
       que chrome-policy.reg côté Windows). -->
  <key>NewTabPageLocation</key>
  <string>http://localhost:3000</string>

  <key>DeveloperToolsAvailability</key>
  <integer>2</integer>

  <key>IncognitoModeAvailability</key>
  <integer>1</integer>

  <key>PrintingEnabled</key>
  <false/>

  <key>DownloadRestrictions</key>
  <integer>3</integer>

  <key>BookmarkBarEnabled</key>
  <false/>

  <key>PasswordManagerEnabled</key>
  <false/>

  <key>BrowserSettingsPageEnabled</key>
  <false/>

  <key>SavingBrowserHistoryDisabled</key>
  <true/>

</dict>
</plist>
