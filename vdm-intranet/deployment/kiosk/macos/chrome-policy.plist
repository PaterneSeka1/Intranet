<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <!-- ── INSTALLATION SILENCIEUSE DE LA PWA ─────────────────────────────
       Chrome installe automatiquement l'app au premier lancement,
       sans aucune interaction utilisateur.                               -->
  <key>WebAppInstallForceList</key>
  <array>
    <dict>
      <key>url</key>
      <string>http://localhost:3000</string>
      <key>default_launch_container</key>
      <string>window</string>
      <key>create_desktop_shortcut</key>
      <true/>
      <key>fallback_app_name</key>
      <string>VDM Intranet</string>
    </dict>
  </array>

  <!-- Ouvre toujours la PWA dans sa propre fenêtre (sans barre navigateur) -->
  <key>WebAppSettings</key>
  <array>
    <dict>
      <key>manifest_id</key>
      <string>http://localhost:3000/</string>
      <key>display_mode</key>
      <string>standalone</string>
    </dict>
  </array>

  <!-- ── RESTRICTIONS ──────────────────────────────────────────────── -->
  <key>NewTabPageLocation</key>
  <string>http://localhost:3000</string>

  <key>DeveloperToolsAvailability</key>
  <integer>2</integer>

  <key>IncognitoModeAvailability</key>
  <integer>1</integer>

  <key>PrintingEnabled</key>
  <false/>

  <key>DownloadRestrictions</key>
  <integer>3</integer>

  <key>BookmarkBarEnabled</key>
  <false/>

  <key>PasswordManagerEnabled</key>
  <false/>

  <key>BrowserSettingsPageEnabled</key>
  <false/>

  <key>SavingBrowserHistoryDisabled</key>
  <true/>

</dict>
</plist>
